{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardgalactic.github.io/spherepop-kernel/spec/schemas/percolation.json",
  "title": "Spherepop Shadow Graph Percolation Invariant",
  "description": "Exact rational p/q Molloy–Reed κ check on cross-boundary dependencies. From UltraGraph §1.2.",
  "type": "object",
  "required": ["graph_cid", "vertices", "shadow_edges", "kappa_ratio", "mean_degree_ratio", "regime", "transitive_risk", "checked_at"],
  "properties": {
    "graph_cid": {
      "type": "string",
      "pattern": "^cid:[a-z0-9]+$",
      "description": "Content-addressed ID of the shadow graph"
    },
    "vertices": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of vertices |V|"
    },
    "shadow_edges": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of cross-boundary edges |E_SHADOW|"
    },
    "mean_degree_ratio": {
      "type": "object",
      "required": ["p", "q"],
      "properties": {
        "p": { "type": "integer", "minimum": 0 },
        "q": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false,
      "description": "Exact reduced rational mean degree c = 2|E|/|V| as p/q"
    },
    "kappa_ratio": {
      "type": "object",
      "required": ["p", "q"],
      "properties": {
        "p": { "type": "integer", "minimum": 0 },
        "q": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false,
      "description": "Exact reduced rational Molloy–Reed percolation ratio κ = (∑ d_v²) / (∑ d_v) as p/q"
    },
    "resonance_trit": {
      "type": "integer",
      "enum": [-1, 0, 1],
      "description": "Solar Phylogenetic Octad trit: +1 at Rung 0 Bonobo resonance (κ = 3/2), 0 subcritical/critical, -1 supercritical (κ > 2)"
    },
    "regime": {
      "type": "string",
      "enum": ["subcritical", "critical", "supercritical"],
      "description": "Erdős–Rényi phase regime"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this check was performed"
    },
    "transitive_risk": {
      "type": "boolean",
      "description": "True iff κ > 2 (giant component exists)"
    }
  },
  "additionalProperties": false
}
