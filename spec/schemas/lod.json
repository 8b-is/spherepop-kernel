{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardgalactic.github.io/spherepop-kernel/spec/schemas/lod.json",
  "title": "Spherepop Szemerédi LOD Super-Node",
  "description": "Zero-float Szemerédi Regularity partition as Universe LOD Shader (Q16.16 + p/q). From UltraGraph §2.",
  "type": "object",
  "required": ["partition_id", "epsilon_ratio", "super_nodes", "steiner_hub", "vertex_count", "edge_count", "checked_at"],
  "properties": {
    "partition_id": {
      "type": "string",
      "pattern": "^cid:[a-z0-9]+$",
      "description": "Content-addressed ID of the partition"
    },
    "epsilon_ratio": {
      "type": "object",
      "required": ["p", "q"],
      "properties": {
        "p": { "type": "integer", "minimum": 1 },
        "q": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false,
      "description": "Exact reduced rational ε-regularity parameter p/q in (0, 1]"
    },
    "super_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sncp_id", "centroid_q16", "weight_ratio", "partition_class", "vertices"],
        "properties": {
          "sncp_id": {
            "type": "string",
            "pattern": "^cid:[a-z0-9]+$",
            "description": "Super Node Centroid Pod ID"
          },
          "centroid_q16": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 2,
            "maxItems": 2,
            "description": "Centroid coordinates (x, y) in Q16.16 fixed-point"
          },
          "weight_ratio": {
            "type": "object",
            "required": ["p", "q"],
            "properties": {
              "p": { "type": "integer", "minimum": 0 },
              "q": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false,
            "description": "Exact reduced rational internal pod density p/q"
          },
          "partition_class": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "V1=mem8::wave, V2=regularity::oracle, V3=felix_asm::simd, V4=phoenix::capsule"
          },
          "vertices": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "description": "Sorted original vertex indices assigned to this super-node"
          },
          "wavefield_q16": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "Discrete wavefield coupling coefficients in Q16.16 fixed-point"
          }
        },
        "additionalProperties": false
      },
      "description": "Array of Super Node Centroid Pods [SNCP]+w"
    },
    "steiner_hub": {
      "type": "string",
      "pattern": "^cid:[a-z0-9]+$",
      "description": "Erdős–Steiner center Z(G) for zero-copy routing"
    },
    "vertex_count": {
      "type": "integer",
      "minimum": 0
    },
    "edge_count": {
      "type": "integer",
      "minimum": 0
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this partition was computed"
    }
  },
  "additionalProperties": false
}
