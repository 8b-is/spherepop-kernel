{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardgalactic.github.io/spherepop-kernel/spec/schemas/footprint.json",
  "title": "Spherepop Environment Footprint",
  "description": "Footprint binds evidence to declared environments with subsumption checking. From Spherepop Development Protocol §14.",
  "type": "object",
  "required": ["footprint_id", "arch", "os", "libc", "runtime_versions", "accelerator", "environment_manifest"],
  "properties": {
    "footprint_id": {
      "type": "string",
      "pattern": "^cid:[a-z0-9]+$",
      "description": "Content-addressed ID of this footprint (CID of canonical JSON)"
    },
    "arch": {
      "type": "string",
      "enum": ["x86_64", "aarch64", "riscv64", "wasm32", "wasm64"],
      "description": "CPU architecture"
    },
    "os": {
      "type": "string",
      "enum": ["linux", "darwin", "windows", "freebsd", "none"],
      "description": "Operating system"
    },
    "libc": {
      "type": "string",
      "enum": ["glibc", "musl", "bionic", "libsystem", "none"],
      "description": "C library (libsystem on macOS, none for bare metal/wasm)"
    },
    "runtime_versions": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9_-]+$": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)*(-[a-z0-9]+)?$",
          "description": "Semantic version string"
        }
      },
      "additionalProperties": false,
      "description": "Runtime versions (e.g., {\"go\": \"1.22.1\", \"rustc\": \"1.75.0\", \"zig\": \"0.16.0\"})"
    },
    "accelerator": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["none", "cuda", "rocm", "metal", "vulkan", "webgpu", "tpu", "npu"]
      },
      "description": "Available accelerators"
    },
    "environment_manifest": {
      "type": "string",
      "pattern": "^cid:[a-z0-9]+$",
      "description": "CID of the full environment manifest (package list, config, etc.)"
    }
  },
  "additionalProperties": false
}